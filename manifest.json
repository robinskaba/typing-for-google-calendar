{
  "manifest_version": 3,
  "name": "Typing for Google Calendar",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Typing for Google Calendar",
    "default_icon": {
      "16": "assets/img/icon_dark.png",
      "48": "assets/img/icon_dark.png",
      "128": "assets/img/icon_dark.png"
    }
  },
  "icons": {
    "16": "assets/img/icon_dark.png",
    "48": "assets/img/icon_dark.png",
    "128": "assets/img/icon_dark.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "identity",
    "storage"
  ],
  "oauth2": {
    "client_id": "418184414363-pqr09o0rulflckf5n5jun8mgr25rc5o7.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar"
    ]
  },
  "key": ""
}